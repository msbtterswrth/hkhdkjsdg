{% set bg_class = background_color ? ('has-bg ' ~ background_color) : 'empty' %}
{% set theme_class = theme ? theme : '' %}

<div class="testimonial {{ bg_class }} {{ theme_class }} {{ image ? ' has-img' : '' }}">
	<div class="container">
		{% if image %}
			<div class="img">
				{{ image }}
			</div>
		{% endif %}

		<div class="text">
			<div class="blurb">
				{% if title %}
					<span class="title">{{ title }}</span>
				{% endif %}
				<p>{{ quote }}</p>
			</div>

			{% if attribution %}
				<span class="attribution">{{ attribution }}</span>
			{% endif %}
		</div>
	</div>
</div>
