{% set catch_cache = content|render %}

{% embed 'base:layout' with {
  background_color: paragraph.field_background_color.value ?: null,
  heading_level: paragraph.field_heading_size.value ?: 'h2',
  title: content.field_title.0 ? content.field_title.0 : null,
  body: content.field_rich_text.0 ? content.field_rich_text : null,
  layout: paragraph.field_layout.value ?: null,
  gutter: paragraph.field_gutter_size.value ?: null
} %}
  {% block items %}
    {{ content.field_items }}
  {% endblock %}
{% endembed %}